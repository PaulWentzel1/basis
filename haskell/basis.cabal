cabal-version:          3.0
name:                   basis
version:                0.1.0.0
license:                MIT
author:                 Paul

library
    hs-source-dirs:     src
    default-language:   Haskell2010
    exposed-modules:
        Math.Combinatorics
        Math.Constants
        Math.Stats
    build-depends:      base

executable basis-exe
    hs-source-dirs:     app
    main-is:            Main.hs
    default-language:   Haskell2010
    build-depends:
        base,
        basis